# CORE
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=

# DATABASE
DATABASE_URL=postgresql://meldstock:meldstock@localhost:5432/meldstock

# AUTH (replace the example secret before running)
BETTER_AUTH_SECRET=replace-with-a-long-random-local-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
MELDSTOCK_BOOTSTRAP_ADMIN_EMAIL=

# MAIL
MAIL_PROVIDER=local
POLSIA_EMAIL_PROXY_URL=

# STORAGE
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/objects
POLSIA_STORAGE_UPLOAD_URL=
POLSIA_LEGACY_STORAGE_ORIGINS=

# AI
AI_PROVIDER=disabled
POLSIA_AI_BASE_URL=

# ANALYTICS
ANALYTICS_PROVIDER=disabled
POLSIA_ANALYTICS_SLUG=
POLSIA_API_BASE_URL=

# Shared temporary Polsia adapter credentials (only when a Polsia provider is selected)
POLSIA_API_KEY=
POLSIA_API_TOKEN=

# SCHEDULER / STARTUP
SCHEDULER_PROVIDER=manual
ENABLE_DEMO_SEED=0

# OPTIONAL BUILD/SEO
IMAGE_REMOTE_HOSTS=
SEO_INDEXABLE=false
SKIP_ENV_VALIDATION=0
